# ManageMate — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Get this from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Session ─────────────────────────────────────────────────────────────────
# A long, random secret string used to sign session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-use-a-long-random-secret-string

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" on Vercel and Render. Leave unset for local development.
NODE_ENV=production

# ─── Server ──────────────────────────────────────────────────────────────────
# Only needed for local development. Vercel ignores PORT.
PORT=3000

# ─── Vercel (auto-set by Vercel, do not set manually) ────────────────────────
# VERCEL_URL is automatically injected by Vercel on every deployment.
# Do not set this yourself.
# VERCEL_URL=your-project.vercel.app
